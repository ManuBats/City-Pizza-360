// CityPizza360 MVP — Modelo: Pedido, Pizza, Insumo, Promocion
// PostgreSQL + Prisma. Regla: sin queso no hay Hawaiana (validada en servicio).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoPedido {
  Recibido
  Preparacion
  Listo
  EnCamino
  Entregado
}

enum Rol {
  Admin
  Cajero
  Cocinero
  Repartidor
  Mesero
}

model Pizza {
  id         Int            @id @default(autoincrement())
  nombre     String         @unique
  precio     Decimal        @db.Decimal(10, 2)
  disponible Boolean        @default(true)
  insumos    PizzaInsumo[]
  detalles   DetallePedido[]
}

model Insumo {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique
  stock       Float          @default(0)
  stockMinimo Float          @default(0)
  unidad      String         @default("u")
  pizzas      PizzaInsumo[]
}

model PizzaInsumo {
  pizzaId  Int
  insumoId Int
  cantidad Float
  pizza    Pizza  @relation(fields: [pizzaId], references: [id], onDelete: Cascade)
  insumo   Insumo @relation(fields: [insumoId], references: [id])

  @@id([pizzaId, insumoId])
}

model Pedido {
  id         Int            @id @default(autoincrement())
  codigo     String         @unique
  nombres    String
  apellidos  String
  celular    String         @db.Char(9)
  direccion  String
  referencia String?
  estado     EstadoPedido   @default(Recibido)
  total      Decimal        @db.Decimal(10, 2)
  creadoEn   DateTime       @default(now())
  detalles   DetallePedido[]
}

model DetallePedido {
  id        Int     @id @default(autoincrement())
  pedidoId  Int
  pizzaId   Int
  cantidad  Int
  precioUnit Decimal @db.Decimal(10, 2)
  pedido    Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pizza     Pizza   @relation(fields: [pizzaId], references: [id])
}

model Promocion {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precioPromo Decimal  @db.Decimal(10, 2)
  inicio      DateTime @default(now())
  fin         DateTime
  activa      Boolean  @default(true)
}

model Trabajador {
  id       Int     @id @default(autoincrement())
  usuario  String  @unique
  nombre   String
  rol      Rol
  passHash String
  activo   Boolean @default(true)
}
